<?xml version="1.0" encoding="utf-8"?>
<!-- Atlas (docs/guides/ANDROID.md, "The full app"): the desktop app's phone part, native — Today, Files, Search, notes — and the
     capture box, tile and screen service of the capture app. The same Java (package org.atlas.capture) and Rust library. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.atlas.app" android:versionCode="13" android:versionName="0.3.1">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Outbox: a job that waits for a network (JobScheduler asks for it; without it the app was killed, 2026-10-19) -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- the outbox job (Outbox) survives a restart of the phone: captures kept offline are still sent -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- "kept captures were sent" (OutboxJob), asked for the first time a capture is kept offline -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- the app's player (MediaService): a book plays on with the screen off, the CPU kept awake while it plays -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- reminders on time with the phone asleep (ReminderAlarms): exact alarms. Android 13+ grants USE_EXACT_ALARM to a
       calendar/reminder app at install; 12 has SCHEDULE_EXACT_ALARM (granted, revocable). Withheld: inexact, still while idle -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <!-- the last screenshot, when all-files access is not given -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <!-- the camera apps, visible to Host.hasCamera / takePhoto (package visibility, Android 11+) -->
  <queries><intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent></queries>
  <application android:networkSecurityConfig="@xml/network" android:label="Atlas" android:icon="@mipmap/ic_launcher" android:extractNativeLibs="true" android:requestLegacyExternalStorage="true">
    <!-- rotating keeps this window and its page (configChanges): recreated, the WebView and the vault opened anew -->
    <!-- enableOnBackInvokedCallback (here, the box and a plugin's screen; Android 14+): predictive back, the gesture
         reaching the activity's own Back path (Shell.onBack); not the application's, so the capture overlay keeps the Back key -->
    <activity android:name="org.atlas.capture.AtlasActivity" android:enableOnBackInvokedCallback="true" android:exported="true" android:theme="@style/App" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- the box: a translucent, dimmed window over whatever was on screen; out of the recent apps, its own task -->
    <activity android:name="org.atlas.capture.CaptureActivity" android:enableOnBackInvokedCallback="true" android:exported="true" android:theme="@style/Capture" android:excludeFromRecents="true" android:taskAffinity="" android:launchMode="singleTask" android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <!-- text selected in any app: "Capture" in its selection menu, the text as a quote -->
      <intent-filter android:label="Capture">
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>
    <!-- the box's own icon (CaptureWays): off until turned on in Settings → Capture; for the home screen, the drawer and a
         Pixel's Quick Tap (double tap on the back opens an app) -->
    <activity-alias android:name="org.atlas.capture.CaptureIcon" android:targetActivity="org.atlas.capture.CaptureActivity" android:label="Capture" android:icon="@mipmap/ic_launcher" android:enabled="false" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <!-- a native plugin as its own app in the launcher ([android] launcher): generated here by build-apk.sh -->
    <!-- plugin launchers (scripts/dev/android-launchers.mjs) -->
    <!-- signing in to a server (docs/guides/ANDROID.md, "Signing in"): the browser comes back to the app's own address -->
    <activity android:name="org.atlas.capture.SignedInActivity" android:exported="true" android:launchMode="singleTask" android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="org.atlas.app" />
      </intent-filter>
    </activity>
    <activity android:name="org.atlas.capture.SignInWebActivity" android:exported="false" android:theme="@style/App" />
    <!-- "Open with → Atlas" for a book, a comic or a PDF from another app (OpenWithActivity): read in the app's own reader -->
    <activity android:name="org.atlas.capture.OpenWithActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:noHistory="true">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="content" />
        <data android:scheme="file" />
        <data android:mimeType="application/epub+zip" />
        <data android:mimeType="application/pdf" />
        <data android:mimeType="application/x-mobipocket-ebook" />
        <data android:mimeType="application/vnd.amazon.ebook" />
        <data android:mimeType="application/x-fictionbook+xml" />
        <data android:mimeType="application/x-cbz" />
        <data android:mimeType="application/vnd.comicbook+zip" />
      </intent-filter>
    </activity>
    <provider android:name="org.atlas.capture.PhotoProvider" android:authorities="org.atlas.app.photos" android:exported="false" android:grantUriPermissions="true" />
    <!-- a native plugin's screen (docs/refactor/REFACTOR-native-plugins.md): Manga, Books… -->
    <activity android:name="org.atlas.capture.PluginActivity" android:enableOnBackInvokedCallback="true" android:exported="false" android:theme="@style/App" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
    <service android:name="org.atlas.capture.CaptureTile" android:exported="true" android:label="@string/tile" android:icon="@drawable/ic_plus" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
    </service>
    <!-- what is playing (Playing): media sessions are shown only to an app with notification access; it reads none -->
    <service android:name="org.atlas.capture.MediaListener" android:exported="true" android:label="@string/media_listener" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
    </service>
    <service android:name="org.atlas.capture.ScreenService" android:exported="true" android:label="@string/screen_service" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/screen_service" />
    </service>
    <!-- the home-screen widget (TodayWidget): today's log, the open tasks, Capture -->
    <receiver android:name="org.atlas.capture.TodayWidget" android:exported="false" android:label="@string/widget">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget" />
    </receiver>
    <!-- the reminders' alarms (ReminderAlarms): its own ring, and set again after a restart of the phone, an update, a
         change of the exact-alarm permission. Exported for those system broadcasts; a ring is checked against the app's vaults -->
    <receiver android:name="org.atlas.capture.ReminderAlarms" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
      </intent-filter>
    </receiver>
    <!-- the buttons on the core's notifications other than Open (Notices, NoticeActions) -->
    <receiver android:name="org.atlas.capture.NoticeActions" android:exported="false" />
    <!-- captures kept while a server did not answer, sent once there is a network (Outbox) -->
    <service android:name="org.atlas.capture.MediaService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
    <service android:name="org.atlas.capture.OutboxJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
  </application>
</manifest>
