<?xml version="1.0" encoding="utf-8"?>
<!-- Atlas capture (docs/guides/ANDROID.md): the capture app — its launcher opens Settings; the box opens from the tile, the
     accessibility button, a share, or "New capture". Java screens (android/java) over the Rust core (libatlas_android.so, JNI). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.atlas.capture" android:versionCode="3" android:versionName="0.2.0">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Outbox: a job that waits for a network (JobScheduler asks for it; without it the app was killed, 2026-10-19) -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- the outbox job (Outbox) survives a restart of the phone: captures kept offline are still sent -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- "kept captures were sent" (OutboxJob), asked for the first time a capture is kept offline -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <!-- the last screenshot, when all-files access is not given -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <application android:label="Atlas capture" android:icon="@mipmap/ic_launcher" android:extractNativeLibs="true" android:requestLegacyExternalStorage="true">
    <!-- opened from the launcher: a normal app, its settings -->
    <activity android:name=".SettingsActivity" android:exported="true" android:theme="@style/App" android:label="Atlas capture">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- the box: a translucent, dimmed window over whatever was on screen; out of the recent apps, its own task -->
    <activity android:name=".CaptureActivity" android:exported="true" android:theme="@style/Capture" android:excludeFromRecents="true" android:taskAffinity="" android:launchMode="singleTask" android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
    </activity>
    <!-- signing in to a server (docs/guides/ANDROID.md, "Signing in"): the browser comes back to the app's own address -->
    <activity android:name=".SignedInActivity" android:exported="true" android:launchMode="singleTask" android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="org.atlas.capture" />
      </intent-filter>
    </activity>
    <activity android:name=".SignInWebActivity" android:exported="false" android:theme="@style/App" />
    <service android:name=".CaptureTile" android:exported="true" android:label="@string/tile" android:icon="@drawable/ic_plus" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
    </service>
    <!-- what is playing (Playing): media sessions are shown only to an app with notification access; it reads none -->
    <service android:name=".MediaListener" android:exported="true" android:label="@string/media_listener" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
    </service>
    <service android:name=".ScreenService" android:exported="true" android:label="@string/screen_service" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/screen_service" />
    </service>
    <!-- captures kept while a server did not answer, sent once there is a network (Outbox) -->
    <service android:name=".OutboxJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
  </application>
</manifest>
