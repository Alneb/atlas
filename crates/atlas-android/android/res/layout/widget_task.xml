<?xml version="1.0" encoding="utf-8"?>
<!-- One open task in the home-screen widget (TodayWidget): a tap opens its note at its line. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_task_text"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp"
    android:gravity="center_vertical" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
