<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- the box over a dimmed screen: no title, a transparent window, the system's dim behind it -->
  <style name="Capture" parent="@android:style/Theme.DeviceDefault.DayNight">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:backgroundDimEnabled">true</item>
    <item name="android:backgroundDimAmount">0.45</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>
  <!-- a normal screen (Settings, the full app): drawn edge to edge, the bars transparent over the app's background -->
  <style name="App" parent="@android:style/Theme.DeviceDefault.DayNight">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>
</resources>
