{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "version": "0.2.11",
  "identifier": "dev.atlas.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "publisher": "alneb",
    "homepage": "https://github.com/Alneb/atlas",
    "license": "AGPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "One fast desktop workspace over plain files",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "linux": {
      "deb": { "files": {
        "/usr/bin/atlas": "../../target/release/atlas",
        "/usr/bin/atlas-capture": "../../target/release/atlas-capture",
        "/usr/bin/atlas-quick-capture": "../../packaging/atlas-quick-capture",
        "/usr/share/applications/atlas-capture.desktop": "../../packaging/atlas-capture.desktop",
        "/usr/share/applications/atlas-capture-box.desktop": "../../packaging/atlas-capture-box.desktop",
        "/usr/share/icons/hicolor/scalable/apps/atlas.svg": "../../packaging/icon/atlas.svg"
      } },
      "appimage": { "files": { "/usr/bin/atlas-capture": "../../target/release/atlas-capture" } },
      "rpm": { "files": {
        "/usr/bin/atlas": "../../target/release/atlas",
        "/usr/bin/atlas-capture": "../../target/release/atlas-capture",
        "/usr/bin/atlas-quick-capture": "../../packaging/atlas-quick-capture",
        "/usr/share/applications/atlas-capture.desktop": "../../packaging/atlas-capture.desktop",
        "/usr/share/applications/atlas-capture-box.desktop": "../../packaging/atlas-capture-box.desktop",
        "/usr/share/icons/hicolor/scalable/apps/atlas.svg": "../../packaging/icon/atlas.svg"
      } }
    }
  }
}
