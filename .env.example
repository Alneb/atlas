# Copy to .env (never committed) and edit; `docker compose` reads it.

# the folder whose subfolders are the vaults (each one at /v/<name>/)
ATLAS_VAULTS=./vaults
# the host's user and group that own those files (`id -u`, `id -g`)
ATLAS_UID=1000
ATLAS_GID=1000
# the port on the host
ATLAS_PORT=7700
# the time zone for dates in notes and logs
TZ=UTC
# a prebuilt image instead of building from this checkout
# ATLAS_IMAGE=ghcr.io/alneb/atlas:latest
