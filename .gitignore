target/
node_modules/
ui/dist/
crates/atlas-app/gen/
*.log
# a vault's cache, wherever a test or a probe opened one
**/.atlas/cache/
*.html
!ui/capture.html
!ui/index.html
.env

# Python caches (generated)
__pycache__/
*.pyc
/local/
# plugins' helper programs, built by each plugin's engine/build.sh (never committed: CI and releases build them)
plugins/*/*/bin/
# the link plugin-ui.mjs makes to ui/node_modules
plugins/*/*/ui/node_modules

# the plugins' engines built for Android by build-apk.sh (packed into the APK, never committed)
crates/atlas-android/helpers/*/
# this machine's real-data paths for the tests (scripts/dev/gate.sh sources it)
scripts/dev/local.env
# Claude Code's per-machine settings and locks
.claude/
# the vaults folder compose.yaml mounts by default
/vaults/
# packages built locally from packaging/flatpak
/dist/
/build-dir/
/.flatpak-builder/
